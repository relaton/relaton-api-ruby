{
  "name": "relaton-api contract fixtures (local Rack dataset)",
  "version": "2.0.0",
  "description": "The same assertion classes as the shared v2.0.0 (v3-only) production fixtures, pinned to the CI fixture dataset (two rfcs docs). Run against the booted Rack app; the production set stays authoritative for the Workers stack.",
  "baseUrlEnv": "RELATON_API_BASE_URL",
  "fixtures": [
    {
      "name": "document: RFC 3986 serves the model JSON by key",
      "path": "/v3/documents/RFC%203986",
      "expect": {
        "status": 200,
        "contentType": "application/json",
        "bodyContains": ["Uniform Resource Identifier"]
      }
    },
    {
      "name": "document: an unknown key is problem+json",
      "path": "/v3/documents/RFC%20NOTHING",
      "expect": { "status": 404, "contentType": "application/problem+json" }
    },
    {
      "name": "document: a key spelling resolves through the normalized token",
      "path": "/v3/documents/RFC3986",
      "expect": { "status": 200, "contentType": "application/json" }
    },
    {
      "name": "negotiation: bibdata XML via format",
      "path": "/v3/documents/RFC%203986?format=xml",
      "headers": { "accept": "application/relaton+xml" },
      "expect": {
        "status": 200,
        "contentType": "application/relaton+xml",
        "bodyContains": ["<bibdata"]
      }
    },
    {
      "name": "negotiation: yaml via Accept",
      "path": "/v3/documents/RFC%203986",
      "headers": { "accept": "application/yaml" },
      "expect": { "status": 200, "contentType": "application/yaml" }
    },
    {
      "name": "collection: pages docid-ordered with a cursor",
      "path": "/v3/documents?limit=1",
      "headers": { "accept": "application/json" },
      "expect": {
        "status": 200,
        "contentType": "application/json",
        "bodyContains": ["\"next_cursor\""]
      }
    },
    {
      "name": "flavors: reports stream coverage",
      "path": "/v3/flavors",
      "headers": { "accept": "application/json" },
      "expect": {
        "status": 200,
        "contentType": "application/json",
        "bodyContains": ["rfcs"]
      }
    },
    {
      "name": "version: the release banner answers",
      "path": "/v3/version",
      "headers": { "accept": "application/json" },
      "expect": { "status": 200, "contentType": "application/json" }
    }
  ]
}
